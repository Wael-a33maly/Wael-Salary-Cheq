# حماية نظام الرواتب على استضافة Hostinger المشتركة (LiteSpeed / Apache)
# متوافق مع كافة إصدارات السيرفر لمنع أي خطأ 500

AddDefaultCharset UTF-8

# منع استعراض محتويات المجلدات بأمان تام
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# منع الوصول المباشر للملفات الحساسة
<FilesMatch "\.(lock|sql|env|git|example|md|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>


