# حماية نظام الرواتب والشيكات والمطابقة على استضافة Hostinger (LiteSpeed / Apache)
AddDefaultCharset UTF-8

# أولوية تحميل الواجهة التفاعلية الشاملة (تطبيق المعاينة الكامل)
DirectoryIndex index.html index.php

# منع استعراض محتويات المجلدات بأمان تام
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# منع الوصول المباشر للملفات الحساسة
<FilesMatch "\.(lock|sql|env|git|example|md|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# دعم الـ Single Page Application (SPA) وتوجيه كافة الروابط للتطبيق الحديث
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # استثناء طلبات API والتنصيب والملفات والمجلدات الموجودة فعلياً
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/install/ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # توجيه أي مسار آخر إلى الواجهة التفاعلية الرئيسية
    RewriteRule ^ index.html [L]
</IfModule>
