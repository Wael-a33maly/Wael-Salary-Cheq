<?php
/**
 * نموذج إعدادات الاتصال بقاعدة البيانات — config/db.php
 * يتم توليد هذا الملف تلقائياً بواسطة سكربت التنصيب (install/index.php)
 * يمكنك تعديل البيانات يدوياً عند نقل الموقع أو تغيير خادم قاعدة البيانات
 */

declare(strict_types=1);

define('DB_HOST', 'localhost');
define('DB_NAME', 'payroll_db');
define('DB_USER', 'payroll_user');
define('DB_PASS', 'payroll_secret_pass');
define('DB_CHARSET', 'utf8mb4');

/**
 * دالة الاتصال بقاعدة البيانات بنمط Singleton واستخدام PDO
 * تضمن استخدام اتصال واحد طوال دورة حياة الطلب مع معالجة الأخطاء
 * 
 * @return PDO
 */
function getDbConnection(): PDO {
    static $pdo = null;

    if ($pdo === null) {
        $dsn = sprintf('mysql:host=%s;dbname=%s;charset=%s', DB_HOST, DB_NAME, DB_CHARSET);
        $options = [
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES   => false,
            PDO::MYSQL_ATTR_INIT_COMMAND => 'SET NAMES ' . DB_CHARSET . ' COLLATE utf8mb4_unicode_ci',
        ];

        try {
            $pdo = new PDO($dsn, DB_USER, DB_PASS, $options);
        } catch (PDOException $e) {
            // تسجيل الخطأ داخلياً وعدم كشف تفاصيل الخادم للمستخدم النهائي
            error_log('Database Connection Failure: ' . $e->getMessage());
            http_response_code(500);
            die('خطأ في الاتصال بقاعدة البيانات. يرجى مراجعة إعدادات config/db.php أو تشغيل سكربت التنصيب.');
        }
    }

    return $pdo;
}
